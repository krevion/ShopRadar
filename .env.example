# Core
NODE_ENV=development
PORT=3000
API_PORT=4000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Local path for development. Production must set an absolute path on persistent storage.
UPLOADS_DIR=uploads/videos
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your-public-mapbox-token

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopradar

# Auth
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Keep disabled until Safaricom production credentials and a public HTTPS callback are configured.
PAYMENTS_ENABLED=false

# Web and mobile
WEB_APP_URL=http://localhost:3000
MOBILE_APP_URL=exp://localhost:8081

# M-Pesa / Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey-goes-here
MPESA_CALLBACK_URL=https://your-public-api.example.com/api/payments/mpesa/callback
