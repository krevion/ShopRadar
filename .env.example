# Core
NODE_ENV=development
PORT=3000
API_PORT=4000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopradar

# Auth
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Web and mobile
WEB_APP_URL=http://localhost:3000
MOBILE_APP_URL=exp://localhost:8081

# Storage / media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=shopradar-media
AWS_CLOUDFRONT_URL=https://your-cloudfront-url.example.com
VIDEO_BUCKET=shopradar-videos

# Maps
GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_MAPS_PLACE_API_KEY=your-google-places-key

# M-Pesa / Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey-goes-here
MPESA_CALLBACK_BASE_URL=http://localhost:4000/api/v1/payments/mpesa/callback
MPESA_TIMEOUT_URL=http://localhost:4000/api/v1/payments/mpesa/callback
MPESA_RESULT_URL=http://localhost:4000/api/v1/payments/mpesa/callback

# ShopRadar billing
SELLER_SUBSCRIPTION_AMOUNT=1000
SELLER_TRIAL_DAYS=30
SUBSCRIPTION_CURRENCY=KES
SETTLEMENT_BANK=ABSA
SETTLEMENT_CURRENCY=KES
SETTLEMENT_ACCOUNT_REFERENCE=shopradar-settlement

# Notification providers
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@shopradar.local

# Push / Firebase
FIREBASE_PROJECT_ID=shopradar-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# External service placeholders
OBJECT_STORAGE_PROVIDER=s3
VIDEO_PROVIDER=s3
GOOGLE_MAPS_ENABLED=false

# Optional feature flags
ENABLE_MOBILE_PUSH=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ADMIN_REVIEW=true
